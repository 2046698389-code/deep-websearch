# 复制为 .env，仅填写要启用的访问方式。不要提交 .env。
# 密钥/权限由各平台提供；安装插件不会创建 API 账号或购买配额。
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=deep-websearch/0.1.0
REDDIT_REFRESH_TOKEN=
X_BEARER_TOKEN=
BRAVE_SEARCH_API_KEY=
SEARXNG_URL=
DOUYIN_CLIENT_KEY=
DOUYIN_CLIENT_SECRET=
# 抖音搜索需平台批准的搜索权限，并在 config.yaml 中明确开启 search_permission。
DOUYIN_DEVICE_ID=
EXA_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
SERPAPI_API_KEY=

# 可选：使用其他位置的配置，建议填绝对路径。
# DEEP_WEBSEARCH_CONFIG=
# DEEP_WEBSEARCH_ENV_FILE=
# 可选：后台运行时彻底关闭 Windows 提醒。
# DEEP_WEBSEARCH_HEADLESS=true
